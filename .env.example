# Copie para ".env" para testar no seu computador. No Render, defina estas
# variáveis em: o seu Web Service > Environment. Nunca envie o .env para o GitHub.

# OBRIGATÓRIO — palavra-passe do painel de administração (/admin). Mínimo 6 caracteres.
ADMIN_PASSWORD=mude-esta-palavra-passe

# OPCIONAL — palavra-passe para criar salas na página inicial. Se não existir,
# usa-se a ADMIN_PASSWORD. (Pode desligar-se a exigência no painel > Definições.)
# ROOM_PASSWORD=

# OBRIGATÓRIO EM PRODUÇÃO — ligação PostgreSQL (Neon, Render Postgres, Supabase…).
# Sem esta variável, o jogo usa um ficheiro SQLite local (só para testes no computador:
# no Render esse ficheiro apaga-se a cada reinício).
# DATABASE_URL=postgresql://utilizador:palavra-passe@servidor/base?sslmode=require

# SSL da base de dados: automático para Neon/Supabase/URL externa do Render.
# Force com true/false só se for preciso.
# DATABASE_SSL=true

# Porta local (o Render define PORT sozinho — não a crie lá).
PORT=3000

# Endereço público usado nos convites (opcional; é detetado automaticamente).
# PUBLIC_URL=https://caca-palavras-desafio-a-dois.onrender.com

# Redirecionar HTTP para HTTPS (opcional; o Render já o faz sozinho).
# FORCE_HTTPS=true

# --- Videochamada (WebRTC) -----------------------------------------------
# STUN gratuito já incluído (funciona na maioria das redes de casa).
# Para redes móveis (4G/5G) ou routers restritivos, configure um servidor TURN
# (ex.: Metered, Cloudflare Calls, Twilio, Xirsys).
# TURN_URL=turn:SERVIDOR:443
#   (ou vários, separados por vírgulas: TURN_URLS=turn:SERVIDOR:80,turns:SERVIDOR:443?transport=tcp)
# TURN_USERNAME=
# TURN_CREDENTIAL=

# --- Limites (opcionais; os valores por omissão servem bem) -----------------
# MAX_ROOMS=300            # salas em simultâneo
# ROOMS_PER_HOUR=12        # salas criadas por endereço IP, por hora, na página inicial
# JOIN_RATE_MAX=25         # tentativas de entrar numa sala por minuto e por IP
# SELECT_RATE_MAX=12       # seleções na grelha por 2 segundos e por jogador
# SOCKET_RATE_MAX=120      # mensagens em tempo real por 5 segundos e por ligação
